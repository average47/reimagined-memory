# Copy to .env and adjust as needed: `cp .env.example .env`
# Compose reads .env automatically from this directory.

# Host port the WordPress network is exposed on.
# NOTE: subdirectory Multisite requires the standard port (80). Using a custom
# port breaks WordPress's network/site domain lookups.
WORDPRESS_PORT=80
WORDPRESS_SITE_URL=http://localhost
WORDPRESS_SITE_TITLE=Reimagined Memory CMS

# Database credentials (shared by the db and wordpress services).
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress
WORDPRESS_DB_ROOT_PASSWORD=root

# Initial admin account created on first launch. CHANGE THESE for anything
# beyond local development.
WORDPRESS_ADMIN_USER=admin
WORDPRESS_ADMIN_PASSWORD=admin
WORDPRESS_ADMIN_EMAIL=admin@example.com
