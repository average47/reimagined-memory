# Copy to .env.local for local development: `cp .env.local.example .env.local`

# Base origin of the headless WordPress Multisite network (see apps/cms).
# Tenant paths (/, /shudder, /acorn, /sundancenow, /wetv) are appended automatically.
WORDPRESS_BASE_URL=http://localhost

# ── Draft Mode preview (WordPress "Preview" button → Next.js) ──
# Shared secret; must match MOSAIC_PREVIEW_SECRET on the WordPress side.
WORDPRESS_PREVIEW_SECRET=mosaic-dev-preview-secret
# WordPress Application Password used to fetch drafts over the REST API.
# Create one: wp-admin → Users → your profile → Application Passwords, or
#   docker compose run --rm --entrypoint wp wp-cli user application-password \
#     create admin "mosaic-preview" --porcelain --url=http://localhost/
WORDPRESS_PREVIEW_USER=admin
WORDPRESS_PREVIEW_APP_PASSWORD=
